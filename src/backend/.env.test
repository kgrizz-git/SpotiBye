# Test environment variables
ENVIRONMENT=test

# Test JWT secret (use a fixed value for test consistency)
JWT_SECRET=test-jwt-secret-for-testing-only

# Test Spotify credentials (mock values for testing)
SPOTIFY_CLIENT_ID=test-client-id
SPOTIFY_CLIENT_SECRET=test-client-secret

# Test Reccobeats API key (mock value)
RECOCOBEATS_API_KEY=test-reccobeats-key

# Comma-separated OAuth redirect_uri allowlist. Mirrors the dev `wrangler.toml`
# value. Tests that want a different allowlist pass overrides via
# `createTestEnv({ ALLOWED_REDIRECT_URIS: ... })`.
ALLOWED_REDIRECT_URIS=http://localhost:3000,http://localhost:3000/callback,http://localhost:8080

# Test KV namespace IDs (use preview IDs)
CACHE_KV_PREVIEW_ID=93fe695dd3b4494dbb566e316031d431
SESSIONS_KV_PREVIEW_ID=df6d2b4394de4335a385f97003fa98d6
