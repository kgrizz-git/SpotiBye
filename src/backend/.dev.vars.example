# Local Cloudflare Worker secrets. Copy to .dev.vars in this directory and
# replace every placeholder. Never commit .dev.vars.
# From the Spotify Developer Dashboard for your app: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="your-local-spotify-client-id"
# From the same Spotify app's Settings page. Keep this value private.
SPOTIFY_CLIENT_SECRET="your-local-spotify-client-secret"
# Generate locally with `openssl rand -hex 32`; use a different value per environment.
JWT_SECRET="generate-a-unique-local-jwt-secret"
