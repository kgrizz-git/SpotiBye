{
  "name": "spotibye-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for SpotiBye Spotify Playlist Exporter",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "./scripts/deploy-with-metadata.sh development",
    "deploy:prod": "./scripts/deploy-with-metadata.sh production",
    "build": "tsc",
    "lint": "eslint **/*.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "js-yaml": "^4.3.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "exceljs": "^4.4.0",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "brace-expansion": "5.0.9",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  }
}
