{
  "name": "spotibye-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for SpotiBye Spotify Playlist Exporter",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:prod": "wrangler deploy --env production",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.15",
    "wrangler": "^3.57.0"
  },
  "dependencies": {
    "hono": "^4.0.0"
  }
}
