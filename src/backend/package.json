{
  "name": "spotibye-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for SpotiBye Spotify Playlist Exporter",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "./scripts/deploy-with-metadata.sh development",
    "deploy:prod": "./scripts/deploy-with-metadata.sh production",
    "build": "tsc",
    "lint": "eslint **/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.15",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "exceljs": "^4.4.0",
    "hono": "^4.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "js-yaml": "^4.2.0"
  }
}
