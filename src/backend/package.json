{
  "name": "spotibye-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for SpotiBye Spotify Playlist Exporter",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "echo 'No default deploy target. Use npm run deploy:dev or npm run deploy:prod.' >&2 && exit 1",
    "deploy:dev": "./scripts/deploy-with-metadata.sh development",
    "deploy:prod": "./scripts/deploy-with-metadata.sh production",
    "build": "tsc",
    "lint": "eslint **/*.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "undici": "^7.30.1",
    "ws": "^8.21.0",
    "nanoid": "^3.3.17",
    "brace-expansion": "^5.0.12",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "source-map-js": "^1.2.2",
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
