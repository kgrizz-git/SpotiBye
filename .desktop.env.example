# SpotiBye desktop-app environment-variable template
# This file is not loaded automatically. Copy it to .desktop.env.local, then
# source that ignored file from your launcher or configure its values in an IDE.
# See dev-docs/guides/environment-setup.md for configuration sources and order.

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Leave all endpoint variables unset to choose a backend in the app. There is
# no automatic localhost or cloud endpoint. The Localhost preset is always
# available; Cloudflare Dev and Cloudflare Prod presets appear only when their
# respective variables contain a valid URL.
# SPOTIBYE_BACKEND_URL=https://your-default-backend.example
# SPOTIBYE_DEV_BACKEND_URL=https://your-dev-backend.example
# SPOTIBYE_PRODUCTION_BACKEND_URL=https://your-prod-backend.example
# Optional override for the explicit Localhost preset:
# SPOTIBYE_LOCALHOST_BACKEND_URL=http://localhost:8787

# Backend Selection. `SPOTIBYE_USE_PRODUCTION=true` uses the configured
# production URL as the environment startup choice.
SPOTIBYE_USE_PRODUCTION=false
SPOTIBYE_ENABLE_BACKEND_SELECTOR=true

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Timeouts (in seconds)
SPOTIBYE_API_TIMEOUT=30
SPOTIBYE_ANALYSIS_TIMEOUT=300
SPOTIBYE_OAUTH_TIMEOUT=300

# OAuth Configuration
SPOTIBYE_OAUTH_PORT=8080

# =============================================================================
# FEATURE FLAGS
# =============================================================================

SPOTIBYE_ENABLE_ANALYSIS=true
SPOTIBYE_ENABLE_EXPORT=true
SPOTIBYE_ENABLE_CACHING=true
SPOTIBYE_ENABLE_OFFLINE=false

# Debug flags
SPOTIBYE_DEBUG_NETWORK=false
SPOTIBYE_DEBUG_AUTH=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

SPOTIBYE_BATCH_SIZE=50
SPOTIBYE_MAX_CONCURRENT=3
SPOTIBYE_MAX_RETRIES=3
SPOTIBYE_RETRY_BACKOFF=1.0
SPOTIBYE_ANALYSIS_POLL_INTERVAL=2.0
SPOTIBYE_MAX_POLL_INTERVAL=10.0

# =============================================================================
# FILE PATHS
# =============================================================================

# TEMP_DIR must be user-private (default: ~/.spotibye_cache/temp_exports).
# Do not point this at a world-writable path like /tmp.
SPOTIBYE_EXPORT_DIR=~/Downloads
SPOTIBYE_TEMP_DIR=~/.spotibye_cache/temp_exports

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=info
