# SpotiBye Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Backend URLs
SPOTIBYE_BACKEND_URL=https://spotibye-backend-development.kevin-grizzard.workers.dev
SPOTIBYE_PRODUCTION_BACKEND_URL=https://spotibye-backend.kevin-grizzard.workers.dev
SPOTIBYE_LOCALHOST_BACKEND_URL=http://localhost:8787

# Backend Selection
SPOTIBYE_USE_PRODUCTION=false
SPOTIBYE_ENABLE_BACKEND_SELECTOR=true

# =============================================================================
# SPOTIFY API CREDENTIALS
# =============================================================================

# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Secret - Generate a strong random string (minimum 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Timeouts (in seconds)
SPOTIBYE_API_TIMEOUT=30
SPOTIBYE_ANALYSIS_TIMEOUT=300
SPOTIBYE_OAUTH_TIMEOUT=300

# OAuth Configuration
SPOTIBYE_OAUTH_PORT=8080

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
SPOTIBYE_ENABLE_ANALYSIS=true
SPOTIBYE_ENABLE_EXPORT=true
SPOTIBYE_ENABLE_CACHING=true
SPOTIBYE_ENABLE_OFFLINE=false

# Debug flags
SPOTIBYE_DEBUG_NETWORK=false
SPOTIBYE_DEBUG_AUTH=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Request batching and concurrency
SPOTIBYE_BATCH_SIZE=50
SPOTIBYE_MAX_CONCURRENT=3
SPOTIBYE_MAX_RETRIES=3
SPOTIBYE_RETRY_BACKOFF=1.0

# Polling intervals (in seconds)
SPOTIBYE_ANALYSIS_POLL_INTERVAL=2.0
SPOTIBYE_MAX_POLL_INTERVAL=10.0

# =============================================================================
# FILE PATHS
# =============================================================================

# Export and temporary directories
SPOTIBYE_EXPORT_DIR=~/Downloads
SPOTIBYE_TEMP_DIR=/tmp/spotibye_exports

# =============================================================================
# CLOUDFLARE WORKERS (Backend)
# =============================================================================

# KV Namespace bindings (configured in wrangler.toml)
CACHE_KV=your_cache_kv_namespace
SESSIONS_KV=your_sessions_kv_namespace

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Development mode settings
NODE_ENV=development
PYTHON_ENV=development

# Logging
LOG_LEVEL=info
